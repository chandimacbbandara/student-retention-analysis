# ============================================================
# Student Retention Analysis — .gitignore
# ============================================================

# ----- Local dataset storage (never commit raw data) --------
/data/

# ----- Python environment & cache ---------------------------
.venv/
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg

# ----- Jupyter Notebook artifacts ---------------------------
.ipynb_checkpoints/
*.ipynb_checkpoints

# ----- Environment variables & secrets ----------------------
.env
.env.*
*.secret

# ----- IDE & OS files ---------------------------------------
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ----- Logs & temporary files -------------------------------
*.log
*.tmp
*.cache
